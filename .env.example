# Safe local defaults. Copy to .env and add only local, non-production values.
FRAUD_ENVIRONMENT=local
FRAUD_LOG_LEVEL=INFO
FRAUD_HOST=127.0.0.1
FRAUD_PORT=8000

# Local PostgreSQL 16 development service from compose.yaml. These credentials are
# intentionally local-only. Change the port in both POSTGRES_PORT and the DSN if needed.
POSTGRES_PORT=5432
FRAUD_POSTGRES_DSN=postgresql+psycopg://fraud_dev:fraud_dev_local_only@127.0.0.1:5432/fraud_detection_dev

# Integration tests require a dedicated local database whose name ends in _test.
# Create it with `make db-test-create`; tests never target the development database.
FRAUD_TEST_POSTGRES_DSN=postgresql+psycopg://fraud_dev:fraud_dev_local_only@127.0.0.1:5432/fraud_detection_test

# Leave cloud dependencies blank. When configured without a production adapter,
# readiness reports the dependency unavailable rather than connected.
FRAUD_COSMOS_NOSQL_ENDPOINT=
FRAUD_COSMOS_NOSQL_KEY=
FRAUD_COSMOS_USE_MANAGED_IDENTITY=false
FRAUD_AZURE_MANAGED_IDENTITY_CLIENT_ID=
FRAUD_COSMOS_NOSQL_DATABASE=
FRAUD_COSMOS_RAW_CONTAINER=transactions_raw
FRAUD_COSMOS_EMBEDDING_CONTAINER=behavior_embeddings
FRAUD_COSMOS_REQUEST_TIMEOUT_SECONDS=10
FRAUD_COSMOS_BATCH_SIZE=500
FRAUD_COSMOS_PAGE_SIZE=500
FRAUD_COSMOS_MAX_RETRIES=3
FRAUD_EMBEDDING_BATCH_SIZE=256
FRAUD_EMBEDDING_PAGE_SIZE=500
FRAUD_VECTOR_SEARCH_LIMIT=10
FRAUD_VECTOR_SIMILARITY_METRIC=cosine
FRAUD_BEHAVIORAL_TEMPLATE_VERSION=behavior-template-v1
FRAUD_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
FRAUD_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
FRAUD_EMBEDDING_VERSION=minilm-l6-v2-1110a243-template-v1-normalized-float32
FRAUD_EMBEDDING_NORMALIZE=true
FRAUD_EMBEDDING_DTYPE=float32
FRAUD_EMBEDDING_MODEL_CACHE=artifacts/models/sentence-transformers
FRAUD_BEHAVIORAL_TEMPLATE_ARTIFACT=data/processed/behavior_templates.parquet
FRAUD_EMBEDDING_LOCAL_ARTIFACT=data/processed/behavior_embeddings.parquet
FRAUD_MODEL_FEATURE_ARTIFACT=data/processed/model_features_v2.parquet
FRAUD_MODEL_ARTIFACT_ROOT=artifacts/models/releases
FRAUD_CORS_ALLOWED_ORIGINS=[]
FRAUD_INVESTIGATOR_DEFAULT_LIMIT=25
FRAUD_INVESTIGATOR_MAX_LIMIT=100
# Local/test bypass is rejected automatically in development, staging, and production.
FRAUD_AUTH_MODE=local_bypass
FRAUD_ENTRA_TENANT_ID=
FRAUD_ENTRA_AUDIENCE=
FRAUD_ENTRA_ISSUER=
FRAUD_ENTRA_JWKS_URL=
FRAUD_ENTRA_REQUIRED_SCOPE=Fraud.Investigate
FRAUD_AUTH_JWKS_CACHE_SECONDS=3600
FRAUD_AUTH_REQUEST_TIMEOUT_SECONDS=5
FRAUD_INCREMENTAL_CHUNK_STEPS=24
FRAUD_INCREMENTAL_ARTIFACT_ROOT=artifacts/incremental/phase8
FRAUD_INCREMENTAL_DATA_ROOT=data/processed/phase8
FRAUD_EMBEDDING_PROGRESS_INTERVAL=5000
FRAUD_GREMLIN_ENDPOINT=
FRAUD_GREMLIN_USERNAME=
FRAUD_GREMLIN_DATABASE=
FRAUD_GREMLIN_GRAPH=
FRAUD_GREMLIN_KEY=
FRAUD_GREMLIN_REQUEST_TIMEOUT_SECONDS=10
FRAUD_GREMLIN_MAX_RETRIES=3
FRAUD_GREMLIN_PROJECTION_BATCH_SIZE=250
FRAUD_GREMLIN_PARTITION_SHARDS=64
FRAUD_LOUVAIN_SEED=73751
FRAUD_LOUVAIN_RESOLUTION=1.0
FRAUD_MODEL_ARTIFACT_URI=
