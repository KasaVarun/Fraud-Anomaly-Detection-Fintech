<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="ERD 1 / Transaction records" id="01-transaction-erd"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="batch" value="&lt;b&gt;INGESTION_BATCH&lt;/b&gt;&lt;hr&gt;PK batch_id : text&lt;br&gt;UK source + seed + chunk&lt;br&gt;sample_seed, enrichment_seed : int&lt;br&gt;chunk_id, split_policy : text&lt;br&gt;status : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="185" width="355" height="192" as="geometry" /></mxCell><mxCell id="account" value="&lt;b&gt;ACCOUNT&lt;/b&gt;&lt;hr&gt;PK account_id : text&lt;br&gt;account_kind : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="355" height="111" as="geometry" /></mxCell><mxCell id="merchant" value="&lt;b&gt;MERCHANT&lt;/b&gt;&lt;hr&gt;PK, FK account_id : text&lt;br&gt;Merchant subtype of ACCOUNT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="350" height="111" as="geometry" /></mxCell><mxCell id="tx" value="&lt;b&gt;TRANSACTION&lt;/b&gt;&lt;hr&gt;PK transaction_id : text&lt;br&gt;FK batch_id : text&lt;br&gt;FK sender_id : text&lt;br&gt;FK receiver_id : text&lt;br&gt;UK batch_id, source_row&lt;br&gt;step : integer&lt;br&gt;transaction_type : text&lt;br&gt;amount : numeric(18,2)&lt;br&gt;source_row : bigint&lt;br&gt;data_split : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="405" height="327" as="geometry" /></mxCell><mxCell id="label" value="&lt;b&gt;TRANSACTION_LABEL&lt;/b&gt;&lt;hr&gt;PK, FK transaction_id : text&lt;br&gt;is_fraud : boolean&lt;br&gt;source_flag : boolean&lt;br&gt;provenance : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1190" y="490" width="350" height="165" as="geometry" /></mxCell><mxCell id="e0" value="contains (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="290" as="sourcePoint" /><mxPoint x="630" y="390" as="targetPoint" /><Array as="points"><mxPoint x="500" y="290" /><mxPoint x="500" y="390" /></Array></mxGeometry></mxCell><mxCell id="e1" value="sends (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="191" as="sourcePoint" /><mxPoint x="800" y="340" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="receives (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="155" as="sourcePoint" /><mxPoint x="630" y="480" as="targetPoint" /><Array as="points"><mxPoint x="560" y="155" /><mxPoint x="560" y="480" /></Array></mxGeometry></mxCell><mxCell id="e3" value="is subtype (1 : 0..1)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="142" as="sourcePoint" /><mxPoint x="1190" y="142" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="has label (1 : 0..1)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="580" as="sourcePoint" /><mxPoint x="1190" y="580" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n0" value="ERD 1 / Transaction records" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="Every transaction has one sender and one receiver. A merchant is an account, so merchant payments use the same receiver FK." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="757" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n2" value="Source labels support evaluation. Model predictions and fraud flags live in ERD 2. Balance fields remain in raw documents for forensic inspection." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="795" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n3" value="PK = primary key   FK = foreign key   UK = unique key   0..* = zero or many   0..1 = optional single record" style="text;html=0;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="55" y="837" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="ERD 2 / Scoring, flags and evaluation" id="02-scoring-erd"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tx" value="&lt;b&gt;TRANSACTION&lt;/b&gt;&lt;hr&gt;PK transaction_id : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="360" height="84" as="geometry" /></mxCell><mxCell id="snapshot" value="&lt;b&gt;GRAPH_SNAPSHOT&lt;/b&gt;&lt;hr&gt;PK snapshot_id : text&lt;br&gt;cutoff_step : integer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="290" width="360" height="111" as="geometry" /></mxCell><mxCell id="model" value="&lt;b&gt;MODEL_VERSION&lt;/b&gt;&lt;hr&gt;PK model_version_id : text&lt;br&gt;feature_set : text&lt;br&gt;training_cutoff_step : integer&lt;br&gt;threshold : numeric&lt;br&gt;embedding_version : text ?&lt;br&gt;artifact_uri : text&lt;br&gt;created_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="490" width="420" height="246" as="geometry" /></mxCell><mxCell id="score" value="&lt;b&gt;TRANSACTION_SCORE&lt;/b&gt;&lt;hr&gt;PK score_id : text&lt;br&gt;FK transaction_id : text&lt;br&gt;FK model_version_id : text&lt;br&gt;FK snapshot_id : text ?&lt;br&gt;input_version : text&lt;br&gt;fraud_probability : numeric&lt;br&gt;vector_distance : double ?&lt;br&gt;scored_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="675" y="185" width="425" height="273" as="geometry" /></mxCell><mxCell id="flag" value="&lt;b&gt;FRAUD_FLAG&lt;/b&gt;&lt;hr&gt;PK flag_id : text&lt;br&gt;UK, FK score_id : text&lt;br&gt;reason : text&lt;br&gt;review_status : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1255" y="245" width="300" height="165" as="geometry" /></mxCell><mxCell id="eval" value="&lt;b&gt;MODEL_EVALUATION&lt;/b&gt;&lt;hr&gt;PK evaluation_id : text&lt;br&gt;FK model_version_id : text&lt;br&gt;FK batch_id : text&lt;br&gt;split_name, metrics, counts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="675" y="625" width="425" height="165" as="geometry" /></mxCell><mxCell id="batch" value="&lt;b&gt;INGESTION_BATCH&lt;/b&gt;&lt;hr&gt;PK batch_id : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1255" y="625" width="300" height="84" as="geometry" /></mxCell><mxCell id="e0" value="receives (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="160" as="sourcePoint" /><mxPoint x="675" y="225" as="targetPoint" /><Array as="points"><mxPoint x="545" y="160" /><mxPoint x="545" y="225" /></Array></mxGeometry></mxCell><mxCell id="e1" value="uses snapshot (0..1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="360" as="sourcePoint" /><mxPoint x="675" y="360" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="produces (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="535" as="sourcePoint" /><mxPoint x="675" y="440" as="targetPoint" /><Array as="points"><mxPoint x="560" y="535" /><mxPoint x="560" y="440" /></Array></mxGeometry></mxCell><mxCell id="e3" value="raises (1 : 0..1)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="330" as="sourcePoint" /><mxPoint x="1255" y="330" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="evaluated in (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="690" as="sourcePoint" /><mxPoint x="675" y="690" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="batch (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="677" as="sourcePoint" /><mxPoint x="1100" y="677" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n0" value="ERD 2 / Scoring, flags and evaluation" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="Each evaluation identifies its model version, exact sampled dataset and train/validation/test split." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="804" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n2" value="Score uniqueness: (transaction_id, model_version_id, input_version). &quot;?&quot; means nullable. A flag is a prediction, not a fraud label." style="text;html=0;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="55" y="846" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="ERD 3 / Network snapshots and account risk" id="03-network-erd"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="batch" value="&lt;b&gt;INGESTION_BATCH&lt;/b&gt;&lt;hr&gt;PK batch_id : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="340" height="84" as="geometry" /></mxCell><mxCell id="snap" value="&lt;b&gt;GRAPH_SNAPSHOT&lt;/b&gt;&lt;hr&gt;PK snapshot_id : text&lt;br&gt;FK batch_id : text&lt;br&gt;cutoff_step : integer&lt;br&gt;algorithm_version : text&lt;br&gt;computed_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="605" y="100" width="405" height="192" as="geometry" /></mxCell><mxCell id="community" value="&lt;b&gt;COMMUNITY&lt;/b&gt;&lt;hr&gt;PK, FK snapshot_id : text&lt;br&gt;PK community_id : integer&lt;br&gt;Composite primary key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1190" y="125" width="355" height="138" as="geometry" /></mxCell><mxCell id="risk" value="&lt;b&gt;ACCOUNT_RISK_PROFILE&lt;/b&gt;&lt;hr&gt;PK, FK account_id : text&lt;br&gt;PK, FK snapshot_id : text&lt;br&gt;FK community_id : integer ?&lt;br&gt;degree_centrality : double&lt;br&gt;weighted_degree : numeric&lt;br&gt;Composite FK: snapshot + community" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="615" y="490" width="450" height="219" as="geometry" /></mxCell><mxCell id="account" value="&lt;b&gt;ACCOUNT&lt;/b&gt;&lt;hr&gt;PK account_id : text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="340" height="84" as="geometry" /></mxCell><mxCell id="e0" value="has snapshots (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="195" as="sourcePoint" /><mxPoint x="605" y="195" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="contains (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="198" as="sourcePoint" /><mxPoint x="1190" y="198" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="profiles (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="292" as="sourcePoint" /><mxPoint x="780" y="490" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="has history (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="580" as="sourcePoint" /><mxPoint x="615" y="580" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="membership (0..1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="263" as="sourcePoint" /><mxPoint x="1065" y="610" as="targetPoint" /><Array as="points"><mxPoint x="1380" y="610" /></Array></mxGeometry></mxCell><mxCell id="n0" value="ERD 3 / Network snapshots and account risk" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="One profile per account per snapshot resolves the account-to-snapshot many-to-many relationship." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="776" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n2" value="A profile belongs to at most one community in that same snapshot. Communities indicate candidate rings, not proven fraud." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="817" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Document + vector model" id="04-document-vector-model"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="raw" value="&lt;b&gt;transactions_raw&lt;/b&gt;&lt;hr&gt;id = transaction_id&lt;br&gt;partition key /sender_id&lt;br&gt;batch_id, source_row, step&lt;br&gt;source_payload {PaySim fields}&lt;br&gt;metadata {device, ip, session, geo}&lt;br&gt;synthetic {seed, fields, version}&lt;br&gt;schema_version, source_version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="135" width="445" height="246" as="geometry" /></mxCell><mxCell id="embed" value="&lt;b&gt;behavior_embeddings&lt;/b&gt;&lt;hr&gt;id = transaction_id + version&lt;br&gt;partition key /sender_id&lt;br&gt;transaction_id, raw_id, raw_pk&lt;br&gt;embedding_version, source_version&lt;br&gt;behavior_text, vector[384]&lt;br&gt;data_split, step&lt;br&gt;reference_eligible : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1085" y="135" width="455" height="246" as="geometry" /></mxCell><mxCell id="sql" value="&lt;b&gt;PostgreSQL TRANSACTION&lt;/b&gt;&lt;hr&gt;transaction_id = raw.id&lt;br&gt;sender_id = raw partition key&lt;br&gt;Label stored separately for evaluation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="575" width="445" height="138" as="geometry" /></mxCell><mxCell id="policy" value="&lt;b&gt;Vector policy&lt;/b&gt;&lt;hr&gt;Path /vector, float32, 384 dimensions&lt;br&gt;Cosine distance, flat index initially&lt;br&gt;Filter eligible TRAIN references&lt;br&gt;Exclude self and future steps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1085" y="575" width="455" height="165" as="geometry" /></mxCell><mxCell id="e0" value="one raw event, zero or more embedding versions (1 : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="330" as="sourcePoint" /><mxPoint x="1085" y="330" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="same stable ID (1 : 1)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="263" y="575" as="sourcePoint" /><mxPoint x="263" y="381" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="indexed by" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=none;startArrow=none;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="381" as="sourcePoint" /><mxPoint x="1300" y="575" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n0" value="Document + vector model" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="Source-of-truth documents preserve original fields. Enriched device/IP/session/geo metadata is explicitly synthetic." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="786" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n2" value="Missing metadata stays absent or null. A vector is a numeric array inside a document, not a separate Azure database service." style="text;html=0;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="55" y="827" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Graph model / Network evidence" id="05-graph-model"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sender" value="&lt;b&gt;Account / sender&lt;/b&gt;&lt;hr&gt;id = account_id, pk = shard(id)&lt;br&gt;source_id, kind = customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="395" height="111" as="geometry" /></mxCell><mxCell id="receiver" value="&lt;b&gt;Account / receiver&lt;/b&gt;&lt;hr&gt;id = account_id, pk = shard(id)&lt;br&gt;Source account identifier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1130" y="80" width="400" height="111" as="geometry" /></mxCell><mxCell id="merchant" value="&lt;b&gt;Merchant&lt;/b&gt;&lt;hr&gt;id = account_id, pk = shard(id)&lt;br&gt;Account subtype, kind = merchant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1130" y="335" width="400" height="111" as="geometry" /></mxCell><mxCell id="device" value="&lt;b&gt;Device&lt;/b&gt;&lt;hr&gt;id = device_id, pk = shard(id)&lt;br&gt;synthetic = true, seed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="650" width="405" height="111" as="geometry" /></mxCell><mxCell id="ip" value="&lt;b&gt;IP&lt;/b&gt;&lt;hr&gt;id = ip_id, pk = shard(id)&lt;br&gt;synthetic = true, seed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1130" y="650" width="400" height="111" as="geometry" /></mxCell><mxCell id="e0" value="TRANSFER_TO  [transaction_id, amount, step] (0..* : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="360" as="sourcePoint" /><mxPoint x="1130" y="155" as="targetPoint" /><Array as="points"><mxPoint x="720" y="360" /><mxPoint x="720" y="155" /></Array></mxGeometry></mxCell><mxCell id="e1" value="PAYS  [transaction_id, amount, step] (0..* : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="404" as="sourcePoint" /><mxPoint x="1130" y="404" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="USES_DEVICE (0..* : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="446" as="sourcePoint" /><mxPoint x="510" y="720" as="targetPoint" /><Array as="points"><mxPoint x="250" y="720" /></Array></mxGeometry></mxCell><mxCell id="e3" value="USES_IP  [event evidence] (0..* : 0..*)" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="446" as="sourcePoint" /><mxPoint x="1330" y="650" as="targetPoint" /><Array as="points"><mxPoint x="350" y="555" /><mxPoint x="1330" y="555" /></Array></mxGeometry></mxCell><mxCell id="n0" value="Graph model / Network evidence" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="TRANSFER_TO covers events with a non-merchant receiver. PAYS covers merchant receivers. Keep original transaction_type on both." style="text;html=0;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="55" y="798" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n2" value="Each edge has one source and target. Per-event IDs make retries idempotent. Infer a device-to-IP link only with same-event evidence." style="text;html=0;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="55" y="836" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Architecture / Data refresh and detection" id="06-refresh-architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="data" value="&lt;b&gt;PaySim CSV&lt;/b&gt;&lt;hr&gt;Initial load + staged batches&lt;br&gt;~200k rows; keep all fraud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="285" height="132" as="geometry" /></mxCell><mxCell id="ingest" value="&lt;b&gt;Python ingestion + SDKs&lt;/b&gt;&lt;hr&gt;Azure timer / Data Factory&lt;br&gt;Initial bulk + incremental batches&lt;br&gt;Validate IDs; fixed-seed metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="380" height="168" as="geometry" /></mxCell><mxCell id="raw" value="&lt;b&gt;Cosmos DB for NoSQL&lt;/b&gt;&lt;hr&gt;transactions_raw&lt;br&gt;Immutable source + metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="340" height="168" as="geometry" /></mxCell><mxCell id="fn" value="&lt;b&gt;Azure Functions&lt;/b&gt;&lt;hr&gt;NoSQL change feed + leases&lt;br&gt;Idempotent projection worker&lt;br&gt;Retry incomplete writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="340" height="172" as="geometry" /></mxCell><mxCell id="vector" value="&lt;b&gt;NoSQL vector layer&lt;/b&gt;&lt;hr&gt;all-MiniLM-L6-v2 embeddings&lt;br&gt;behavior_embeddings, vector index" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="485" y="377" width="365" height="150" as="geometry" /></mxCell><mxCell id="graph" value="&lt;b&gt;Cosmos DB for Gremlin&lt;/b&gt;&lt;hr&gt;Account, merchant, device, IP&lt;br&gt;Transaction and usage edges" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="665" width="420" height="145" as="geometry" /></mxCell><mxCell id="ml" value="&lt;b&gt;Python analysis and scoring&lt;/b&gt;&lt;hr&gt;Local training; Azure scoring&lt;br&gt;NetworkX + scikit-learn / LightGBM&lt;br&gt;Tabular + graph + vector features" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="370" height="184" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL Flexible Server&lt;/b&gt;&lt;hr&gt;Accounts, transactions, risk profiles&lt;br&gt;Scores, flags, KPIs, model versions&lt;br&gt;Batch status + refresh watermark" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="370" height="184" as="geometry" /></mxCell><mxCell id="e0" value="batch" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="180" as="sourcePoint" /><mxPoint x="440" y="180" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="raw events" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="180" as="sourcePoint" /><mxPoint x="960" y="180" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="stable entities + pending batch" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="268" as="sourcePoint" /><mxPoint x="220" y="352" as="targetPoint" /><Array as="points"><mxPoint x="555" y="302" /><mxPoint x="220" y="302" /></Array></mxGeometry></mxCell><mxCell id="e3" value="change feed" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="268" as="sourcePoint" /><mxPoint x="1130" y="370" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="embeddings" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="454" as="sourcePoint" /><mxPoint x="850" y="454" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="vertices + edges" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="542" as="sourcePoint" /><mxPoint x="1190" y="665" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" value="historical graph export" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="740" as="sourcePoint" /><mxPoint x="410" y="740" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e7" value="prior fraud similarity features" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=none;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="527" as="sourcePoint" /><mxPoint x="235" y="630" as="targetPoint" /><Array as="points"><mxPoint x="650" y="578" /><mxPoint x="235" y="578" /></Array></mxGeometry></mxCell><mxCell id="e8" value="SQL I/O" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=classic;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="630" as="sourcePoint" /><mxPoint x="140" y="536" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n0" value="Architecture / Data refresh and detection" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="Publish a batch only after raw, graph, vectors and scores reconcile. Power BI and FastAPI consume the published outputs (next diagram)." style="text;html=0;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="839" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Architecture / Reporting and investigation" id="07-investigation-architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="powerbi" value="&lt;b&gt;Power BI dashboards&lt;/b&gt;&lt;hr&gt;KPIs, exposure and ring summaries&lt;br&gt;Transaction drill-through" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="435" height="140" as="geometry" /></mxCell><mxCell id="copilot" value="&lt;b&gt;Copilot Studio investigator&lt;/b&gt;&lt;hr&gt;Natural-language questions&lt;br&gt;Read-only FastAPI actions&lt;br&gt;Answers cite transaction evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1070" y="80" width="455" height="167" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;FastAPI orchestration&lt;/b&gt;&lt;hr&gt;Allowlisted SQL, Gremlin and vector queries&lt;br&gt;Join on stable transaction/account identifiers&lt;br&gt;Return evidence IDs, source versions, freshness&lt;br&gt;Report unavailable stores and partial results" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="350" width="655" height="213" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;hr&gt;Published scores and flags&lt;br&gt;KPI and community views" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="690" width="410" height="130" as="geometry" /></mxCell><mxCell id="raw" value="&lt;b&gt;Cosmos DB for NoSQL&lt;/b&gt;&lt;hr&gt;Raw transaction documents&lt;br&gt;384-d vectors + similarity matches" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="570" y="690" width="460" height="130" as="geometry" /></mxCell><mxCell id="graph" value="&lt;b&gt;Cosmos DB for Gremlin&lt;/b&gt;&lt;hr&gt;Shared devices / IPs&lt;br&gt;Multi-hop money flow paths" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1140" y="690" width="420" height="130" as="geometry" /></mxCell><mxCell id="e0" value="SQL reporting" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=classic;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="230" as="sourcePoint" /><mxPoint x="170" y="690" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="API action" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=classic;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="247" as="sourcePoint" /><mxPoint x="1135" y="450" as="targetPoint" /><Array as="points"><mxPoint x="1290" y="450" /></Array></mxGeometry></mxCell><mxCell id="e2" value="SQL" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=classic;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="563" as="sourcePoint" /><mxPoint x="330" y="690" as="targetPoint" /><Array as="points"><mxPoint x="595" y="616" /><mxPoint x="330" y="616" /></Array></mxGeometry></mxCell><mxCell id="e3" value="point + vector queries" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=classic;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="563" as="sourcePoint" /><mxPoint x="800" y="690" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="Gremlin" style="edgeStyle=none;html=1;fontSize=18;strokeColor=#586A79;endArrow=classic;startArrow=classic;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="563" as="sourcePoint" /><mxPoint x="1320" y="690" as="targetPoint" /><Array as="points"><mxPoint x="1010" y="616" /><mxPoint x="1320" y="616" /></Array></mxGeometry></mxCell><mxCell id="n0" value="Architecture / Reporting and investigation" style="text;html=0;align=left;fontSize=32;" vertex="1" parent="1"><mxGeometry x="42" y="0" width="1500" height="40" as="geometry" /></mxCell><mxCell id="n1" value="A dashboard drill-through can open a transaction investigation through FastAPI. Copilot summarizes retrieved evidence, not hidden labels." style="text;html=0;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="50" y="842" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Database design / Cross-model relationships" id="08-cross-model-links"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="acct" value="&lt;b&gt;SQL ACCOUNT&lt;/b&gt;&lt;hr&gt;PK account_id&lt;br&gt;customer or merchant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2369A5;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="360" height="138" as="geometry" /></mxCell><mxCell id="vertex" value="&lt;b&gt;Gremlin Account / Merchant&lt;/b&gt;&lt;hr&gt;id = SQL account_id, pk = shard(id)&lt;br&gt;One vertex per account ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="410" height="138" as="geometry" /></mxCell><mxCell id="event" value="&lt;b&gt;Gremlin transaction edge&lt;/b&gt;&lt;hr&gt;id = transaction_id + edge type&lt;br&gt;source + target vertex IDs / pk&lt;br&gt;TRANSFER_TO or PAYS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#157D79;fontColor=#243747;fontSize=19;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometr