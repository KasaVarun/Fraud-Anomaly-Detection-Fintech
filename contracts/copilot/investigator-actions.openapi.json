  "info": {
    "description": "Six bounded published-only FastAPI actions for Copilot Studio. Authentication and the deployed HTTPS server are configured in Phase 11.",
    "title": "Fraud Investigator Read-Only Actions",
    "version": "phase10-v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/dashboard/flags": {
      "get": {
        "description": "Returns deterministic cursor pagination over locked-model published flags.",
        "operationId": "listPublishedFraudFlags",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "review_status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "open",
                    "reviewed"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Review Status"
            }
          },
          {
            "in": "query",
            "name": "minimum_score",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Minimum Score"
            }
          },
          {
            "in": "query",
            "name": "transaction_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "CASH_IN",
                    "CASH_OUT",
                    "DEBIT",
                    "PAYMENT",
                    "TRANSFER"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Transaction Type"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A valid bearer token is required."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The authenticated principal lacks the required permission."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request parameters are invalid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An unexpected error occurred."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A required evidence dependency is unavailable."
          }
        },
        "security": [
          {
            "entraOpenId": []
          }
        ],
        "summary": "List published fraud flags",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/v1/dashboard/summary": {
      "get": {
        "description": "Returns bounded published-only aggregates without source-label performance metrics.",
        "operationId": "getPublishedDashboardSummary",
        "parameters": [
          {
            "in": "query",
            "name": "start_step",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Step"
            }
          },
          {
            "in": "query",
            "name": "end_step",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Step"
            }
          },
          {
            "in": "query",
            "name": "transaction_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "CASH_IN",
                    "CASH_OUT",
                    "DEBIT",
                    "PAYMENT",
                    "TRANSFER"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Transaction Type"
            }
          },
          {
            "in": "query",
            "name": "flagged",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Flagged"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A valid bearer token is required."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The authenticated principal lacks the required permission."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request parameters are invalid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An unexpected error occurred."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A required evidence dependency is unavailable."
          }
        },
        "security": [
          {
            "entraOpenId": []
          }
        ],
        "summary": "Get published transaction and score aggregates",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/v1/investigations/accounts/{account_id}/related": {
      "get": {
        "description": "Returns published-snapshot relationships with bounded parameterized graph traversal.",
        "operationId": "getRelatedAccountEvidence",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "relationship_type",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "all",
                "money_flow",
                "shared_device",
                "shared_ip"
              ],
              "title": "Relationship Type",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
