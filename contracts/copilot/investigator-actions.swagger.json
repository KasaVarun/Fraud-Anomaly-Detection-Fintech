  "host": "{deployed-api-host}",
  "info": {
    "description": "Template for the six approved read-only actions. Generate a tenant-specific ignored export before Gate B connector import.",
    "title": "Fraud Investigator Copilot Studio Connector",
    "version": "phase11-gate-a-v1"
  },
  "paths": {
    "/v1/dashboard/flags": {
      "get": {
        "description": "Returns deterministic cursor pagination over locked-model published flags.",
        "operationId": "listPublishedFraudFlags",
        "parameters": [
          {
            "default": 25,
            "in": "query",
            "maximum": 100,
            "minimum": 1,
            "name": "limit",
            "required": false,
            "type": "integer"
          },
          {
            "enum": [
              "open",
              "reviewed"
            ],
            "in": "query",
            "name": "review_status",
            "required": false,
            "type": "string",
            "x-nullable": true
          },
          {
            "in": "query",
            "maximum": 1,
            "minimum": 0,
            "name": "minimum_score",
            "required": false,
            "type": "number",
            "x-nullable": true
          },
          {
            "enum": [
              "CASH_IN",
              "CASH_OUT",
              "DEBIT",
              "PAYMENT",
              "TRANSFER"
            ],
            "in": "query",
            "name": "transaction_type",
            "required": false,
            "type": "string",
            "x-nullable": true
          },
          {
            "in": "query",
            "maxLength": 1024,
            "name": "cursor",
            "required": false,
            "type": "string",
            "x-nullable": true
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "schema": {
              "$ref": "#/definitions/EvidenceEnvelope"
            }
          },
          "401": {
            "description": "A valid bearer token is required.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "The authenticated principal lacks the required permission.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "422": {
            "description": "Request parameters are invalid.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "503": {
            "description": "A required evidence dependency is unavailable.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "entraOAuth2": [
              "api://{api-application-client-id}/{Fraud.Investigate-scope}"
            ]
          }
        ],
        "summary": "List published fraud flags",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/v1/dashboard/summary": {
      "get": {
