{
  "activeReportingModel": {
    "filterRule": "Filter score, flag, trend, and evaluation visuals to this version until a separately approved release changes the contract.",
    "modelVersionId": "model:lightgbm_combined:1e9a3fc0a52dbac541bf4f92"
  },
  "contractVersion": "power-bi-dashboard-v1",
  "interpretationWarnings": [
    "A fraud flag is an investigation signal, not proof of fraud or guilt.",
    "Synthetic device/IP links and graph communities do not establish real-world coordination.",
    "PaySim amounts are synthetic dataset units, not customer money.",
    "No observed-fraud KPI is exposed because source labels remain protected and evaluation-only."
  ],
  "measures": [
    {
      "denominator": "Not applicable; this is the distinct published transaction count at batch grain.",
      "description": "All transactions in published batches, whether scored or unscored.",
      "expression": "SUM(reporting_batch_freshness[published_transaction_count])",
      "name": "Published Transactions",
      "sourceView": "reporting_batch_freshness"
    },
    {
      "denominator": "Not applicable; this is a distinct transaction count for the active model.",
      "description": "Published transactions with an immutable score for the active model.",
      "expression": "CALCULATE(DISTINCTCOUNT(reporting_published_transaction[transaction_id]), NOT(ISBLANK(reporting_published_transaction[score_id])), reporting_published_transaction[model_version_id] = SELECTEDVALUE(reporting_system_lineage[active_model_version]))",
      "name": "Scored Transactions",
      "sourceView": "reporting_published_transaction"
    },
    {
      "denominator": "Not applicable; this is a distinct flagged transaction count for the active model.",
      "description": "Published scored transactions with a threshold-consistent flag.",
      "expression": "CALCULATE(DISTINCTCOUNT(reporting_published_transaction[transaction_id]), reporting_published_transaction[is_flagged] = TRUE(), reporting_published_transaction[model_version_id] = SELECTEDVALUE(reporting_system_lineage[active_model_version]))",
      "name": "Flagged Transactions",
      "sourceView": "reporting_published_transaction"
    },
    {
      "denominator": "Scored Transactions; unscored transactions are excluded.",
      "description": "Flagged scored transactions divided by scored transactions.",
      "expression": "DIVIDE([Flagged Transactions], [Scored Transactions], 0)",
      "name": "Flag Rate",
      "sourceView": "reporting_published_transaction"
    },
    {
      "denominator": "Not applicable; each published transaction amount is counted once.",
      "description": "Published amount total in synthetic PaySim dataset units.",
      "expression": "SUMX(VALUES(reporting_published_transaction[transaction_id]), CALCULATE(MAX(reporting_published_transaction[amount])))",
      "name": "Total Transaction Amount",
      "sourceView": "reporting_published_transaction"
    },
    {
      "denominator": "Not applicable; each flagged published transaction amount is counted once.",
      "description": "Flagged amount total in synthetic PaySim dataset units.",
      "expression": "SUMX(FILTER(VALUES(reporting_published_transaction[transaction_id]), CALCULATE(MAX(reporting_published_transaction[is_flagged])) = TRUE()), CALCULATE(MAX(reporting_published_transaction[amount])))",
      "name": "Flagged Exposure",
      "sourceView": "reporting_published_transaction"
    },
    {
      "denominator": "Not applicable; selects one latest published batch with a stable batch-ID tie-break.",
      "description": "Identifier of the latest published batch.",
      "expression": "MAXX(TOPN(1, FILTER(reporting_batch_freshness, reporting_batch_freshness[is_published] = TRUE()), reporting_batch_freshness[batch_created_at], DESC, reporting_batch_freshness[batch_id], DESC), reporting_batch_freshness[batch_id])",
      "name": "Latest Published Batch",
      "sourceView": "reporting_batch_freshness"
    },
    {
      "denominator": "Not applicable; maximum PaySim step across published batches.",
      "description": "Published data freshness watermark in PaySim steps.",
      "expression": "MAXX(FILTER(reporting_batch_freshness, reporting_batch_freshness[is_published] = TRUE()), reporting_batch_freshness[published_max_step])",
      "name": "Latest Published Cutoff Step",
      "sourceView": "reporting_batch_freshness"
    },
    {
      "denominator": "Not applicable; counts pending batch rows.",
      "description": "Batches awaiting reconciliation/publication.",
      "expression": "COUNTROWS(FILTER(reporting_batch_freshness, reporting_batch_freshness[batch_status] = \"pending\"))",
      "name": "Pending Batch Count",
      "sourceView": "reporting_batch_freshness"
    },
    {
      "denominator": "Not applicable; maximum score timestamp for the active model.",
      "description": "Most recent published active-model score timestamp.",
      "expression": "CALCULATE(MAX(reporting_published_transaction[scored_at]), reporting_published_transaction[model_version_id] = SELECTEDVALUE(reporting_system_lineage[active_model_version]))",
      "name": "Latest Score Time",
      "sourceView": "reporting_published_transaction"
    }
  ],
