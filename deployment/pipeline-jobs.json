{
  "schema_version": "phase11-private-pipeline-jobs-v1",
  "concurrency_policy": "All stages acquire one PostgreSQL advisory lock; each Container Apps job allows one replica and one completion.",
  "staging": "Private Standard_LRS Azure Blob Storage is operational artifact staging only and is not an analytical data store.",
  "stages": [
    { "name": "schema-migration", "job_suffix": "migrate", "worker_stage": "schema-migration", "timeout_seconds": 900, "retry_limit": 1, "cpu": 0.5, "memory": "1Gi", "publication": false },
    { "name": "initial-relational-load", "job_suffix": "initial-load", "worker_stage": "initial-relational-load", "timeout_seconds": 3600, "retry_limit": 1, "cpu": 1.0, "memory": "2Gi", "publication": false },
    { "name": "raw-projection", "job_suffix": "raw-project", "worker_stage": "raw-projection", "timeout_seconds": 7200, "retry_limit": 1, "cpu": 1.0, "memory": "2Gi", "publication": false },
    { "name": "graph-projection", "job_suffix": "graph-project", "worker_stage": "graph-projection", "timeout_seconds": 7200, "retry_limit": 1, "cpu": 1.0, "memory": "2Gi", "publication": false },
    { "name": "behavioral-embeddings", "job_suffix": "embeddings", "worker_stage": "behavioral-embeddings", "timeout_seconds": 14400, "retry_limit": 0, "cpu": 2.0, "memory": "4Gi", "publication": false },
    { "name": "graph-snapshot", "job_suffix": "graph-snapshot", "worker_stage": "graph-snapshot", "timeout_seconds": 14400, "retry_limit": 0, "cpu": 2.0, "memory": "4Gi", "publication": false },
    { "name": "feature-model", "job_suffix": "feature-model", "worker_stage": "feature-model", "timeout_seconds": 14400, "retry_limit": 0, "cpu": 2.0, "memory": "4Gi", "publication": false },
    { "name": "incremental", "job_suffix": "incremental", "worker_stage": "incremental", "timeout_seconds": 7200, "retry_limit": 0, "cpu": 2.0, "memory": "4Gi", "publication": false },
    { "name": "reconciliation", "job_suffix": "reconcile", "worker_stage": "reconciliation", "timeout_seconds": 3600, "retry_limit": 0, "cpu": 1.0, "memory": "2Gi", "publication": false },
    { "name": "evaluation", "job_suffix": "evaluate", "worker_stage": "evaluation", "timeout_seconds": 3600, "retry_limit": 0, "cpu": 1.0, "memory": "2Gi", "publication": false },
    { "name": "publication", "job_suffix": "publish", "worker_stage": "publication", "timeout_seconds": 1800, "retry_limit": 0, "cpu": 0.5, "memory": "1Gi", "publication": true, "confirmation": "PUBLISH:<exact-batch-id>" }
  ]
}
